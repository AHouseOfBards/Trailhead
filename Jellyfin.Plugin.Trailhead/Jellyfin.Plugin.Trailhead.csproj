<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Trailhead</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.Trailhead</AssemblyName>
    <Version>0.1.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Built against the lowest 12.x package so one build loads on every 12.x server (T3: 12.x and later only).
         CI overrides this (-p:JellyfinVersion=12.4.0) to catch API changes in newer releases. -->
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">12.0.0</JellyfinVersion>
    <!-- A class library leaves its NuGet dependencies out of bin, so Certes was missing from the folder that ships
         and binchk found it unloadable. Jellyfin's own packages stay out: they are ExcludeAssets="runtime". -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
    <!-- Exact pin: 5.0.0-beta.1 is the version the T-S2 spike was tested against. Brings BouncyCastle. -->
    <PackageReference Include="Certes" Version="[5.0.0-beta.1]" />
    <!-- Exact pin: the waiter asks each authoritative nameserver directly (T44), which the system resolver cannot do. -->
    <PackageReference Include="DnsClient" Version="[1.8.0]" />
    <!-- Exact pin: 2.3.0 is the version the T-S1 spike ran inside Jellyfin 12.4 (research/edge-spike.md). Edge uses
         only IHttpForwarder and HttpTransformer from it. Brings System.IO.Hashing, which Jellyfin doesn't ship. -->
    <PackageReference Include="Yarp.ReverseProxy" Version="[2.3.0]" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Dns\parent-domains.json" LogicalName="parent-domains.json" />
    <!-- One table per language: copy en.json to <code>.json and translate it, and this picks it up. -->
    <EmbeddedResource Include="Web\i18n\*.json" LogicalName="Trailhead.i18n.%(Filename).json" />
    <!-- Named by hand: the default name would carry the folder and could change with a move. Plugin.GetPages() uses these. -->
    <EmbeddedResource Include="Web\trailhead.html" LogicalName="Jellyfin.Plugin.Trailhead.Web.trailhead.html" />
    <EmbeddedResource Include="Web\trailhead.js" LogicalName="Jellyfin.Plugin.Trailhead.Web.trailhead.js" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.Trailhead.Tests" />
    <InternalsVisibleTo Include="Jellyfin.Plugin.Trailhead.PebbleTests" />
  </ItemGroup>

  <Import Project="..\Campground.Shared\Campground.Shared.props" />

</Project>
