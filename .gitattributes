# Normalise to LF in the repository; check out native on Windows.
* text=auto

*.cs   text eol=lf
*.csproj text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.js   text eol=lf
*.html text eol=lf
*.css  text eol=lf

# Shell scripts must be LF or they will not execute on Linux.
*.sh   text eol=lf

# Images and binaries must never be line-ending converted.
*.png  binary
*.jpg  binary
*.ico  binary
*.dll  binary
*.zip  binary
tools/*.sh -text
tests/gate.sh -text
